programa {
  funcao inicio() {
    //vetor com 5 posições:indices 0, 1, 2, 3 e 4
    inteiro numeros [5]
    numeros [0] = -99999 // primeira posição
    numeros [1] = 10000 // segunda posição
    numeros [2] = 42424 // terceira posição
    numeros [3] = 763427 // quarta posição
    numeros [4] = 99999 // quinta posição
    escreva(" Esse é o melhor número do mundo: ",numeros[2])
  }
}
