programa {
  funcao inicio() {
    //Declaração da variável(criando a "caixa")
    cadeia nomeUsuario
    //ENTRADA:capturando dados do usário
    escreva("Digite o seu nome:")
    leia(nomeUsuario)
    //SAÍDA: exibindo o resultado
    escreva("Olá ",nomeUsuario,"!")
  }
}
